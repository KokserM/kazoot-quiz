# Copy to backend/.env for local development. Never commit real values.
# In Railway, set these as service variables.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Extra allowed browser origins (comma-separated), e.g. https://www.kazoot.app
CORS_ALLOWED_ORIGINS=

# --- AI generation (secret) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Cost estimate per 1M tokens in USD, used for budget caps. Keep in line with OpenAI pricing.
OPENAI_EST_INPUT_COST_PER_1M=4
OPENAI_EST_OUTPUT_COST_PER_1M=20
OPENAI_TIMEOUT_MS=45000
# Hard spending caps (USD). Generation stops when reached; demo keeps working.
DAILY_OPENAI_BUDGET_USD=3
MONTHLY_OPENAI_BUDGET_USD=30
FREE_AI_GAMES_PER_MONTH=3
MAX_AI_GENERATIONS_PER_USER_PER_HOUR=5
MAX_AI_GENERATIONS_PER_IP_PER_HOUR=10

# --- Supabase (secret: service role key bypasses RLS; backend only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (secret) --- use sk_test_... outside production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_CREDIT_PACK_20_PRICE_ID=
STRIPE_CREDIT_PACK_60_PRICE_ID=
STRIPE_CREDIT_PACK_150_PRICE_ID=
# Plans offered to new buyers (all plans keep working for existing customers)
BILLING_VISIBLE_PLANS=
# Emails an invoice for packs carrying the EU withdrawal-waiver confirmation (small Stripe fee)
STRIPE_PACK_INVOICES=false

# --- Game server ---
MAX_PLAYERS_PER_SESSION=150
MAX_DEMO_PLAYERS=30
MAX_ACTIVE_SESSIONS=500
MAX_CONNECTED_PLAYERS=5000
HOST_GRACE_MS=20000
ANSWER_GRACE_MS=400
SHUTDOWN_GRACE_MS=8000
# Behind Railway's proxy
TRUST_PROXY=1

# --- Operations ---
DETAILED_HEALTH=false
DIAGNOSTICS_SECRET=
