# Build-time, PUBLIC values (they end up in the browser bundle). No secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPPORT_EMAIL=support@kazoot.app
# Seller identity shown on legal pages (required before selling in the EU)
VITE_LEGAL_SELLER_NAME=
VITE_LEGAL_REGISTRY_CODE=
VITE_LEGAL_VAT_NUMBER=
VITE_LEGAL_ADDRESS=
# Only when the API is on a different origin than the site
VITE_BACKEND_URL=
